{
  "name": "retrace",
  "version": "0.1.0",
  "description": "A deterministic agent runtime. Every run is a replayable event log — rewind it, fork it from any step, and only pay for what changed.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "retrace": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "keywords": [
    "agent",
    "llm",
    "claude",
    "anthropic",
    "replay",
    "determinism",
    "time-travel",
    "observability"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
